# Ambientes e caches locais podem ser recriados a partir das dependencias.
**/.venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/Ultralytics/
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
**/Thumbs.db
**/.DS_Store

# Estado e logs do servidor temporario; backups e registros do projeto ficam incluidos.
sistema_ia/.runtime/*.log
sistema_ia/.runtime/review_server.json
sistema_ia/.runtime/jobs/

# Documentos pessoais aguardam a decisao sobre publicacao/visibilidade.
/Documentos PUCTEC/*
!/Documentos PUCTEC/Apresentação DRONECAMP PUCTEC.pdf

# Busca aberta: só o checkpoint com as frases embutidas (models/zero_shot) é versionado.
sistema_ia/models/mobileclip*.ts
sistema_ia/models/yoloe-*.pt
# Gerado na primeira execucao de suggest --zero-shot (o envio LFS pela nuvem foi recusado).
sistema_ia/models/zero_shot/

# Documentos pessoais (identidade, histórico, conta bancária, termos): nunca no repositório público.
Documentação/Documentos PUCTEC/*
!Documentação/Documentos PUCTEC/Apresentação DRONECAMP PUCTEC.pdf
# Fotos de campanha (GB): ficam no disco; a revisão guarda cópias com hash em data/reviews.
Conjunto De Dados De Treinamento/Imagens - DroneCamp/

# Revisões de fotos de drone (GB): cópias congeladas, recortes e evidências ficam só no disco;
# registro, sugestões e arquivos de revisão (leves) são versionados.
sistema_ia/data/reviews/ceasa_lado_a_*/originals/
sistema_ia/data/reviews/ceasa_lado_a_*/images/
sistema_ia/data/reviews/ceasa_lado_a_*/evidence/
# Datasets piloto com fotos de drone de 20 MP: imagens refeitas pelo build-pilot-data (hash conferido).
sistema_ia/data/pilot/*ladoA*/images/
