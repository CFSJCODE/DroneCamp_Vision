{
  "_comentario": "Aprendizado mútuo YOLO26 + RF-DETR + D-FINE (mutual_learning.py). Explicação de cada campo: docs/aprendizado_mutuo_dml_rl.md. Quando o treino 614d070a terminar, troque weights do yolo26 pelo best.pt dele (mesmas classes v7).",
  "imgsz": 640,
  "models": [
    {"name": "yolo26", "family": "yolo26", "weights": "yolo26m.pt", "lr": 0.001, "grad_clip": 10.0},
    {"name": "rfdetr", "family": "rfdetr", "variant": "medium", "lr": 0.0001, "grad_clip": 0.1},
    {"name": "dfine", "family": "dfine", "variant": "ustc-community/dfine-medium-coco", "lr": 0.0001, "grad_clip": 0.1}
  ],
  "train": {"epochs": 60, "batch": 4, "weight_decay": 0.0001, "seed": 42, "eval_conf": 0.25,
            "hflip": 0.5, "vflip": 0.0, "threads": 12, "device": "cpu"},
  "consistency": {"lambda": 0.5, "ramp_epochs": 5, "ramp_rounds": 2, "tau": 0.3, "fuse_iou": 0.55,
                  "anchor": "gt", "anchor_iou": 0.5, "temperature": 1.0, "box_weight": 1.0,
                  "negative_weight": 0.0, "max_per_peer": 100, "ema": 0.9},
  "rl": {"enabled": true, "arms": [0.5, 0.0, 1.0, 0.25], "gamma": 0.9, "exploration": 0.05}
}
