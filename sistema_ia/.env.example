# Copie este arquivo para sistema_ia/.env (o .env é ignorado pelo git) e preencha.
# A chave do OpenRouter NUNCA vai para código, documentação, testes, PR ou memória.
OPENROUTER_API_KEY=
# Opcional: slug fixo de um modelo gratuito com imagem (veja `python -m dronecamp_ia list-free-models`).
# Sem definir, vale o "model" de configs/vlm_assist.json (roteador openrouter/free).
# OPENROUTER_MODEL=
# Opcional: outra API compatível com OpenAI (padrão: https://openrouter.ai/api/v1).
# OPENROUTER_BASE_URL=
